{
  "name": "drover-job-search",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight job search and tracking tool",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,browser -c cyan,magenta \"npm:dev:server\" \"npm:dev:browser\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:browser": "esbuild src/main.ts --bundle --format=esm --outfile=www/js/main.js --tsconfig=tsconfig.browser.json --watch",
    "build": "npm run build:server && npm run build:browser",
    "build:server": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:browser": "esbuild src/main.ts --bundle --format=esm --outfile=www/js/main.js --tsconfig=tsconfig.browser.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json --noEmit",
    "verify": "oxfmt check . && oxlint . && npm run typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/autoload": "^6.5.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/static": "^8.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "esbuild": "^0.25.12",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
